# Copy to .env.local and fill in. Never commit .env.local.

# --- Database -------------------------------------------------------------
# Host-side value. Inside docker compose the web service overrides the host to
# `postgres`, since that is the service name on the compose network.
DATABASE_URL="postgresql://roughstack:roughstack_dev@localhost:5432/roughstack"

# --- Auth -----------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3100"

# GitHub OAuth app: https://github.com/settings/developers
# Callback URL: http://localhost:3100/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Google OAuth client: https://console.cloud.google.com/apis/credentials
# Callback URL: http://localhost:3100/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Execution engine -----------------------------------------------------
# `local` uses Docker. `stub` emits synthetic development results and must never
# be used for official evaluation.
EXECUTION_MODE="local"

# Build locally with: docker build -t roughstack-execution-runtime:latest ./sprite
EXECUTION_RUNTIME_IMAGE="roughstack-execution-runtime:latest"

# Path-delimited roots containing public arena packages. A sibling checkout keeps
# arena source and platform source independently maintainable.
BYTEARENA_ARENA_ROOTS="../challenges/challenges"
# Production only: generated by `npm run arena:registry -- <output.json>`.
BYTEARENA_ARENA_REGISTRY=""
