# Copy to .env.local and fill in. Never commit .env.local.

# --- Database -------------------------------------------------------------
# Host-side value. Inside docker compose the web service overrides the host to
# `postgres`, since that is the service name on the compose network.
DATABASE_URL="postgresql://bytearena:bytearena_dev@localhost:5432/bytearena"

# --- Auth -----------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3100"

# GitHub OAuth app: https://github.com/settings/developers
# Callback URL: http://localhost:3100/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Google OAuth client: https://console.cloud.google.com/apis/credentials
# Callback URL: http://localhost:3100/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Execution engine -----------------------------------------------------
# `local` runs Sprites via the local Docker daemon, `fly` uses the Machines API.
EXECUTION_MODE="local"

# Sprite container image. Locally this is built by `npm run sprite:build`.
SPRITE_IMAGE="bytearena-sprite:latest"

# Path-delimited roots containing public arena packages. A sibling checkout keeps
# arena source and platform source independently maintainable.
BYTEARENA_ARENA_ROOTS="../bytearena-arenas/arenas"

# Required only when EXECUTION_MODE=fly.
# Create with: fly tokens create org
FLY_API_TOKEN=""
FLY_APP_NAME="bytearena-sprites"
FLY_REGION="iad"
