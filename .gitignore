# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/tests/e2e/__artifacts__
# Regenerated on every audit run; large binaries that would churn every commit.
/tests/e2e/__screenshots__

# Design research: scraped reference pages and scratch capture scripts.
# Large, regenerable, and not part of the product.
/.research
/docs/*
!/docs/adr/
!/docs/adr/**
!/docs/architecture-audit.md
# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# The template carries no secrets and must be committed.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
