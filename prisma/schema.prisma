generator client {
  provider = "prisma-client-js"
}

// Prisma 7 moved the connection URL out of the schema. It now lives in
// `prisma.config.ts` for CLI/migration use, and is supplied to the client at
// runtime through a driver adapter in `src/lib/db.ts`.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth models. Shapes are dictated by @auth/prisma-adapter, including the
// snake_case columns on Account, so they are intentionally not renamed.
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts    Account[]
  sessions    Session[]
  submissions Submission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Domain models
// ---------------------------------------------------------------------------

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum Language {
  GO
  PYTHON
}

enum SubmissionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  TIMEOUT
}

model Challenge {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  /// One-line hook shown on the challenge card.
  summary     String
  /// Full problem statement, rendered as markdown.
  description String     @db.Text
  difficulty  Difficulty
  /// Grouping label such as "Storage" or "Memory".
  category    String
  languages   Language[]

  /// Per-language starter code, keyed by Language enum value.
  starterCode Json
  /// Markdown describing the interface the solution must implement.
  interfaceDoc String? @db.Text

  timeLimitSec  Int @default(30)
  memoryLimitMb Int @default(512)

  /// Declares which metrics the harness emits and how to display and score them.
  metricsConfig Json
  /// Metrics produced by a known-good solution, used as the comparison baseline.
  referenceMetrics Json?

  /// Display order in the challenge list.
  sortOrder   Int     @default(0)
  isPublished Boolean @default(false)

  submissions Submission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, sortOrder])
}

model Submission {
  id          String           @id @default(cuid())
  userId      String
  challengeId String
  language    Language
  code        String           @db.Text
  status      SubmissionStatus @default(PENDING)

  /// Identifier of the ephemeral machine or container that ran this submission.
  machineId String?
  /// Populated when the run fails before producing a result.
  error     String? @db.Text

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge  Challenge  @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  result     Result?

  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  @@index([userId, createdAt])
  @@index([challengeId])
  @@index([status])
}

model Result {
  id           String @id @default(cuid())
  submissionId String @unique

  passed          Boolean
  score           Int
  executionTimeMs Int

  /// Metric name to numeric value, matching the challenge's metricsConfig.
  metrics Json
  /// Per-case correctness results from the standard workload.
  testResults Json
  /// Per-case results from the fault-injection suite.
  adversarialResults Json?

  stdout String? @db.Text
  stderr String? @db.Text

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}
