generator client {
  provider = "prisma-client-js"
}

// Prisma 7 moved the connection URL out of the schema. It now lives in
// `prisma.config.ts` for CLI/migration use, and is supplied to the client at
// runtime through a driver adapter in `src/lib/db.ts`.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth models. Shapes are dictated by @auth/prisma-adapter, including the
// snake_case columns on Account, so they are intentionally not renamed.
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts    Account[]
  sessions    Session[]
  submissions Submission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Domain models
// ---------------------------------------------------------------------------

/// The three rungs a ladder is divided into. A ladder teaches one idea in
/// escalating form, so difficulty is a position in a sequence rather than a
/// loose label.
enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum Language {
  GO
  PYTHON
  C
  CPP
  JAVA
  RUST
}

enum SubmissionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  TIMEOUT
}

model Challenge {
  id      String @id @default(cuid())
  slug    String @unique
  title   String
  /// One-line hook shown on the challenge card.
  summary String

  /// The problem statement, as an array of typed content blocks rather than a
  /// markdown blob. One renderer draws any array, so a new challenge is data
  /// rather than a new page. See src/lib/blocks/types.ts.
  blocks Json

  difficulty Difficulty
  /// Grouping label such as "Storage" or "Memory".
  category   String
  languages  Language[]

  /// Which frontend pack supplies this challenge's bespoke blocks and
  /// illustrations, for example "ssd". Packs register themselves; the core
  /// renderer never learns what they contain.
  pack String @default("ssd")

  /// Which registered sprite task grades this challenge, for example
  /// "victim-selection". Must match a name in the sprite task registry.
  task String

  /// Ladders group the rungs that teach one idea in escalating form. Rungs in
  /// the same ladder share a key and are ordered by tier, so the arena can
  /// offer "next rung" without a self-relation.
  ladder String
  tier   Int    @default(1)

  /// Per-language starter code, keyed by Language enum value.
  starterCode Json
  /// Parameters handed to the sprite task, such as seed and geometry.
  taskParams  Json?

  timeLimitSec  Int @default(30)
  memoryLimitMb Int @default(512)

  /// Declares which metrics the harness emits and how to display and score them.
  metricsConfig    Json
  /// Metrics produced by a known-good solution, used as the comparison baseline.
  referenceMetrics Json?

  /// Display order in the challenge list.
  sortOrder   Int     @default(0)
  isPublished Boolean @default(false)

  submissions Submission[]
  replies     Reply[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, sortOrder])
  @@index([ladder, tier])
}

/// A short comment on a problem statement.
///
/// Replies are capped, reject code blocks, and can be marked as containing a
/// hint. The intent is discussion of the idea, not distribution of solutions,
/// so the constraints are part of the model rather than a UI convention.
model Reply {
  id          String @id @default(cuid())
  challengeId String
  /// Anonymous session identifier, so a visitor can see and delete their own
  /// replies before signing in.
  sessionId   String
  /// Short display handle derived from the session, for example "anon-4f2a".
  authorLabel String

  body String @db.Text
  /// Marks a reply as containing a hint. The UI renders it blurred until the
  /// reader chooses to see it.
  isSpoiler Boolean @default(false)
  /// Set when a reply is withdrawn. Kept rather than deleted so reply counts
  /// and thread ordering stay stable.
  isHidden  Boolean @default(false)

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([challengeId, createdAt])
  @@index([sessionId, createdAt])
}

model Submission {
  id          String           @id @default(cuid())
  userId      String?
  /// Anonymous session identifier (from the variant cookie). Used to group
  /// a visitor's submissions before they sign in, so the dashboard can
  /// show their history without requiring auth.
  sessionId   String?
  challengeId String
  language    Language
  code        String           @db.Text
  status      SubmissionStatus @default(PENDING)

  /// Identifier of the ephemeral machine or container that ran this submission.
  machineId String?
  /// Populated when the run fails before producing a result.
  error     String? @db.Text

  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge  Challenge  @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  result     Result?

  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
  @@index([challengeId])
  @@index([status])
}

model Result {
  id           String @id @default(cuid())
  submissionId String @unique

  passed          Boolean
  score           Int
  executionTimeMs Int

  /// Metric name to numeric value, matching the challenge's metricsConfig.
  metrics Json
  /// Per-case correctness results from the standard workload.
  testResults Json
  /// Per-case results from the fault-injection suite.
  adversarialResults Json?

  stdout String? @db.Text
  stderr String? @db.Text

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}
